{
  "name": "jotai-tap",
  "version": "0.0.1",
  "description": "Jotai extension to use React hooks to power atoms",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "peerDependencies": {
    "jotai": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.5",
    "jotai": "^2.16.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "dependencies": {
    "@assistant-ui/tap": "^0.9.12"
  }
}
